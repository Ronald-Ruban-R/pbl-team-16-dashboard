# ==============================================================================
# PBL Team Dedicated Dashboard — Streamlit Secrets Template
# Copy this file to `.streamlit/secrets.toml` (or paste into Streamlit Cloud Secrets)
# ==============================================================================

[github]
organization = "PBL-Cohort-X-Teams-13-18"
repositories = [
  "pbl-team-16"
]
api_base_url = "https://api.github.com"
timeout_seconds = 15
max_retries = 3
token = "PASTE_YOUR_TEAM_16_GITHUB_TOKEN_HERE"

[dashboard]
cache_ttl_seconds = 120
stale_progress_days = 10
stale_repo_commit_days = 14
sqlite_db_path = "data/team16_dashboard.db"
enable_github_writeback = true

[auth.users.RONALDRUBAN]
display_name = "RONALDRUBAN (Team 16 Lead)"
role = "owner"
password_hash = "pbkdf2_sha256$260000$10151f10a18742d32f8b4f454c5f5f75$d363b92899b3ebcddeaf90349d118725439873617f7ab6d58406218a7b107514"
allowed_repos = ["pbl-team-16"]

