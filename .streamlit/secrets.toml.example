# ==============================================================================
# PBL Cohort-X Mentor Dashboard — Streamlit Secrets Example
# Copy this file to `.streamlit/secrets.toml` and populate with real values.
# NEVER commit `.streamlit/secrets.toml` to version control.
# ==============================================================================

[github]
organization = "PBL-Cohort-X-Teams-13-18"
repositories = [
  "pbl-team-13",
  "pbl-team-14",
  "pbl-team-15",
  "pbl-team-16",
  "pbl-team-17",
  "pbl-team-18"
]
api_base_url = "https://api.github.com"
timeout_seconds = 15
max_retries = 3

# ------------------------------------------------------------------------------
# OPTION A (Recommended for Production): GitHub App Installation Authentication
# ------------------------------------------------------------------------------
# app_id = "<YOUR_GITHUB_APP_ID>"
# installation_id = "<YOUR_ORG_INSTALLATION_ID>"
# private_key_pem = """-----BEGIN RSA PRIVATE KEY-----
# <YOUR_GITHUB_APP_PRIVATE_KEY_PEM_CONTENT>
# -----END RSA PRIVATE KEY-----"""

# ------------------------------------------------------------------------------
# OPTION B (For Initial Prototype): Fine-Grained Personal Access Token (PAT)
# Must be scoped to organization `PBL-Cohort-X-Teams-13-18` with Repository Contents (Read-only)
# and Metadata (Read-only) across `pbl-team-13`..`pbl-team-18`.
# ------------------------------------------------------------------------------
token = "<YOUR_FINE_GRAINED_GITHUB_PAT_PLACEHOLDER>"

[dashboard]
cache_ttl_seconds = 300
stale_progress_days = 10
stale_repo_commit_days = 14
sqlite_db_path = "data/mentor_dashboard.db"
enable_github_writeback = false

# ==============================================================================
# Dashboard User Accounts & Role-Based Access Control (RBAC)
# Generate password hashes via:
#   python3 -c "from src.security import hash_password_pbkdf2; print(hash_password_pbkdf2('<YOUR_STRONG_PASSWORD>'))"
# ==============================================================================

[auth.users.owner1]
display_name = "Organization Owner 1"
role = "owner"
email = "owner1@example.edu"
password_hash = "<PBKDF2_SHA256_HASH_PLACEHOLDER_OWNER_1>"
allowed_repos = ["*"]

[auth.users.owner2]
display_name = "Organization Owner 2"
role = "owner"
email = "owner2@example.edu"
password_hash = "<PBKDF2_SHA256_HASH_PLACEHOLDER_OWNER_2>"
allowed_repos = ["*"]

# Optional future student-facing account (strictly isolated to a single team repository):
# [auth.users.team13_student]
# display_name = "Team 13 Student Representative"
# role = "student"
# password_hash = "<PBKDF2_SHA256_HASH_PLACEHOLDER_TEAM_13>"
# allowed_repos = ["pbl-team-13"]
